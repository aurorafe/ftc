{
  "name": "@aurorafe/eslint-config-base",
  "description": "aurorafe eslint config",
  "license": "MIT",
  "type": "module",
  "version": "3.0.0",
  "files": [
    "index.js",
    "prettier.js",
    "base.js",
    "package.json",
    "CHANGELOG.md",
    "rules"
  ],
  "exports": {
    ".": "./index.js",
    "./base": "./base.js",
    "./prettier": "./prettier.js",
    "./rules": "./rules/index.js",
    "./rules/prettier": "./rules/prettier.js"
  },
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/aurorafe/ftc.git",
    "directory": "packages/eslint-config-basic"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "lint": "eslint -c index.js .",
    "test": "eslint -c index.js index.js base.js prettier.js rules"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@html-eslint/parser": "0.64.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsonc": "3.3.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "globals": "17.7.0",
    "prettier": "3.9.5"
  },
  "peerDependencies": {
    "eslint": ">=9.22.0"
  },
  "devDependencies": {
    "eslint": "10.7.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "eslint",
    "eslintconfig"
  ]
}
